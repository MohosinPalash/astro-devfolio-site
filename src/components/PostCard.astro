---
interface Props {
  title: string;
  description: string;
  dateOfPub: Date;
  url: string;
}

const { title, description, dateOfPub, url } = Astro.props;
---


  <a href={url} class = "card">
    <h3>{title}</h3>
    <p class="muted">{dateOfPub.toDateString()}</p>
    <p>{description}</p>
  </a>

