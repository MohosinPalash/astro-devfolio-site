---
import { site, myInfo } from '../data/site';
---

<header>
    <nav class="container">
        <a href="/" class="logo">{site.title}</a>
        <div class="links">
            <a href="/">Home</a>
            <a href="/about">About</a>
            <a href="/blogs">Blogs</a>
        </div>
    </nav>
</header>

<style>
    nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 20px;
    }
    .links {
        display: flex;
        align-items: center;
        gap: 20px;
    }
    .logo {
        font-weight: 700;
        color: var(--text);
    }
</style>